{
  "name": "zys-goldfields-intake",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "sh -c 'PY=./venv/bin/python; [ -x \"$PY\" ] || PY=python3; exec \"$PY\" intake_app.py --serve --host 0.0.0.0 --port \"${PORT:-8080}\"'",
    "dev": "sh -c 'PY=./venv/bin/python; [ -x \"$PY\" ] || PY=python3; exec \"$PY\" intake_app.py --serve --host 127.0.0.1 --port \"${PORT:-8080}\"'"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
