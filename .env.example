# ==============================================================================
# ZYS GoldFields PRO LLC — Environment Configuration Template
# Copy to .env for local testing or add these keys under Render -> Environment.
# NEVER commit your real .env file or API secrets to git.
# ==============================================================================

# --- Core Portal Security & Custom Domain ---
PUBLIC_MODE=1
# Primary custom domain for all magic claim links (/claim?prospect_id=...) and canonical links.
BASE_URL=https://grants.zysgoldfields.pro
# Optional extra comma-separated CORS origins (grants.zysgoldfields.pro & onrender.com are allowed by default)
# CORS_ALLOWED_ORIGINS=https://grants.zysgoldfields.pro,https://zys-goldfields-intake.onrender.com
# Strong random bearer token protecting /api/intakes, /api/audits, /api/prospects, /api/outreach-status, and /api/cron/run-outreach
ADMIN_API_TOKEN=replace-with-secure-random-token

# --- Persistent Lakebase Postgres on Neon (Prevents SQLite wipe on Render redeploys) ---
# Leave unset locally to fall back cleanly to SQLite (grants.db).
# On Neon / Render:
#   - DATABASE_URL: Direct (unpooled) connection string used for schema DDL & migrations
#   - DATABASE_URL_POOLED: Pooled (-pooler) connection string used for app queries
#   - Automatically falls back to Neon Serverless HTTPS /sql if TCP 5432 is blocked
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-your-project-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# NEON_SQL_TRANSPORT=auto

# --- Neon Managed Better Auth (Staff Portal /auth, /api/auth/*, /api/me) ---
NEON_AUTH_BASE_URL=https://ep-your-project.neonauth.us-west-2.aws.neon.tech/neondb/auth
# NEON_AUTH_JWKS_URL=https://ep-your-project.neonauth.us-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# --- Transactional Email Notifications & Automated Outreach (Resend) ---
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
ADMIN_NOTIFICATION_EMAIL=Ksandzhar@gmail.com
NOTIFICATION_FROM_EMAIL=grants@zysgoldfields.pro

# --- Domain Warm-Up & Automated Follow-Up Scheduler ---
# Initial daily cap for combined Day 0, Day 4, and Day 9 outreach batches (default: 5/day)
DAILY_SEND_LIMIT=5

# --- Optional: Secondary Persistent JSON Backup Webhook (Make / Zapier / n8n) ---
# BACKUP_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id
# BACKUP_WEBHOOK_SECRET=whsec_replace_with_hmac_secret

# --- Optional: Fallback SMTP Settings (only needed if not using Resend) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=Ksandzhar@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
