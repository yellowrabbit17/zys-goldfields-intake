# ==============================================================================
# ZYS GoldFields PRO LLC — Environment Configuration Template
# Copy to .env for local testing or add these keys under Render -> Environment.
# NEVER commit your real .env file or API secrets to git.
# ==============================================================================

# --- Core Portal Security & Custom Domain ---
PUBLIC_MODE=1
# Set to https://portal.zysgoldfields.pro once your Porkbun CNAME DNS record points to Render.
# Leave as https://zys-goldfields-intake.onrender.com until DNS is configured.
BASE_URL=https://portal.zysgoldfields.pro
# Strong random bearer token protecting /api/intakes, /api/audits, /api/prospects, /api/outreach-status, and /api/cron/run-outreach
ADMIN_API_TOKEN=replace-with-secure-random-token

# --- Persistent PostgreSQL Storage (Prevents SQLite wipe on Render redeploys) ---
# Leave unset locally to fall back cleanly to SQLite (grants.db).
# On Render, set to your free Neon / Supabase / Render PostgreSQL connection string:
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# --- Transactional Email Notifications & Automated Outreach (Resend) ---
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_resend_api_key
ADMIN_NOTIFICATION_EMAIL=Ksandzhar@gmail.com
NOTIFICATION_FROM_EMAIL=grants@zysgoldfields.pro

# --- Domain Warm-Up & Automated Follow-Up Scheduler ---
# Initial daily cap for combined Day 0, Day 4, and Day 9 outreach batches (recommended: 5-10/day)
DAILY_SEND_LIMIT=8

# --- Optional: Secondary Persistent JSON Backup Webhook (Make / Zapier / n8n) ---
# BACKUP_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id
# BACKUP_WEBHOOK_SECRET=whsec_replace_with_hmac_secret

# --- Optional: Fallback SMTP Settings (only needed if not using Resend) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=Ksandzhar@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
